-# #about wraps the hero too, so /about lands at the top of the page content
.about-section#about
  .hero
    = render "static_pages/section_label", section: "about"
    -# Mobile-only identity card (desktop identity lives in the left rail)
    .hero-idcard
      .hero-avatar
        = image_tag "sauvik_bio_sphere.png", alt: "Sauvik Das", fetchpriority: "high"
      .hero-idcard-text
        %p.hero-eyebrow Associate Professor · CMU HCII
        %p.hero-tagline Human-centered security, privacy, AI
    -# SF-17: the lab + institution eyebrow anchors who this page belongs to
    %p.hero-lab-eyebrow Security, Privacy, Usability and Design Lab · Carnegie Mellon HCII
    %h1.hero-pitch I design systems that give people more agency over their personal data and experiences online.
    .hero-ctas
      %a.btn-sd.btn-sd-primary{href: "/publications", "data-turbolinks" => "false", "data-section-link" => true}
        %svg{width: "15", height: "15", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden" => "true"}
          %line{x1: "5", y1: "12", x2: "19", y2: "12"}
          %polyline{points: "12 5 19 12 12 19"}
        Publications
      %a.btn-sd.btn-sd-secondary{href: "/recruiting", "data-turbolinks" => "false", "data-section-link" => true}
        %svg{width: "15", height: "15", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden" => "true"}
          %path{d: "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"}
          %circle{cx: "9", cy: "7", r: "4"}
          %path{d: "M23 21v-2a4 4 0 0 0-3-3.87"}
          %path{d: "M16 3.13a4 4 0 0 1 0 7.75"}
        Recruiting status
      = link_to asset_path("cv.pdf"), class: "btn-sd btn-sd-secondary", target: "_blank", data: { analytics_event: "cv_download" } do
        %svg{width: "15", height: "15", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden" => "true"}
          %path{d: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"}
          %polyline{points: "14 2 14 8 20 8"}
        CV / Résumé
    -# SF-01 (mobile): recruiting status + recovery path directly under the CTAs
    .hero-recruit
      - if @recruiting_status.present?
        %a.hero-recruit-badge{href: "/recruiting", "data-turbolinks" => "false", "data-section-link" => true}= "#{@recruiting_status} · #{@recruiting_cycle}"
      %a.hero-apply-link{href: "https://www.hcii.cmu.edu/academics/phd-hci", target: "_blank", rel: "noopener noreferrer"}
        Apply to the HCII Ph.D. program →

  .about-grid
    .about-main
      .about-text
        I am an Associate Professor (without indefinite tenure) at
        =link_to "Carnegie Mellon University's", "https://www.cmu.edu"
        =link_to "Human-Computer Interaction Institute.", "https://www.hcii.cmu.edu"
        I am also co-founder and Chief Technology Officer of
        =link_to "FuguUX,", "https://www.fuguux.com"
        an early-stage start-up dedicated to improving web usability.
      .about-text
        At CMU, I direct the
        =link_to "SPUD (Security, Privacy, Usability and Design) Lab.", "https://cs.cmu.edu/~spudlab"
        We work at the intersection of HCI, AI and cybersecurity/privacy.
      -# SF-11: research directions as chunked, scannable theme rows — inside the
      -# grid's text column so they start right after the bio, beside the card
      .research-directions#researchDirections
        .research-directions-head
          %p.research-directions-title Some key research directions include:
          %button.research-directions-toggle#directionsToggle{type: "button", "aria-expanded" => "false"}
            = "+ #{@research_directions.length - 3} more directions"
            %svg{width: "12", height: "12", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden" => "true"}
              %polyline{points: "6 9 12 15 18 9"}
        - @research_directions.each_with_index do |dir, i|
          .research-dir{class: (i >= 3 ? "is-collapsed" : nil)}
            %h3.research-dir-title= dir[:title]
            .research-dir-links
              - dir[:links].first(3).each do |l|
                = link_to l[:label], l[:href], class: "project-highlight", target: "_blank"
              - if dir[:links].length > 3
                - dir[:links].drop(3).each do |l|
                  = link_to l[:label], l[:href], class: "project-highlight is-extra", target: "_blank", hidden: true
                %button.research-dir-more{type: "button", "aria-expanded" => "false"}= "Show #{dir[:links].length - 3} more"
        .venue-legend
          %span.venue-legend-label Venue abbreviations
          %span= @venue_legend
    %aside.recognition-card{"aria-label" => "Recognition"}
      %span.recognition-label Recognition
      - @recognition[:awards].each do |row|
        .recognition-row
          - case row[:icon]
          - when "medal"
            %svg.recognition-icon{width: "15", height: "15", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden" => "true"}
              %circle{cx: "12", cy: "8", r: "6"}
              %path{d: "M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"}
          - when "trophy"
            %svg.recognition-icon{width: "15", height: "15", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden" => "true"}
              %path{d: "M6 9H4.5a2.5 2.5 0 0 1 0-5H6"}
              %path{d: "M18 9h1.5a2.5 2.5 0 0 0 0-5H18"}
              %path{d: "M4 22h16"}
              %path{d: "M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"}
              %path{d: "M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"}
              %path{d: "M18 2H6v7a6 6 0 0 0 12 0V2Z"}
          - else
            %svg.recognition-icon{width: "15", height: "15", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden" => "true"}
              %polygon{points: "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"}
          %span= row[:text]
      %a.recognition-more#awardsFilterLink{href: "/publications?tag=award-winning", "data-turbolinks" => "false"}
        See award-winning papers →
      .recognition-divider
      %span.recognition-label In the press
      %p.recognition-press= @recognition[:press]

%section#recruiting
  = render "static_pages/section_label", section: "recruiting"
  .recruiting-box
    %p.recruiting-status= "#{@recruiting_status} · #{@recruiting_cycle}"
    %h2.recruiting-title Prospective Ph.D. Students
    .recruiting-body
      %p
        While I do not plan on accepting any new students at this time, I encourage you to apply to the
        = link_to "HCII Ph.D. program", "https://www.hcii.cmu.edu/academics/phd-hci", target: "_blank"
        at CMU to work with my fantastic colleagues.
    -# SF-05/SF-25: "not recruiting" is never a dead end — intent-tailored alternatives + next-cycle timing
    .recruiting-alternatives
      .recruiting-intents{role: "group", "aria-label" => "Show guidance for"}
        %span.recruiting-alternatives-label What you can do instead — I'm a…
        %button.recruiting-intent-btn.active#intentStudentBtn{type: "button", "aria-pressed" => "true"} Prospective Ph.D. student
        %button.recruiting-intent-btn#intentCollabBtn{type: "button", "aria-pressed" => "false"} Collaborator / visitor
      %ul.recruiting-alternatives-list#intentStudentPanel
        %li
          = link_to "Apply to the HCII Ph.D. program", "https://www.hcii.cmu.edu/academics/phd-hci", target: "_blank", rel: "noopener noreferrer"
          — you can work with my fantastic colleagues, and lab collaborations often cross advisors.
        %li
          = link_to "Watch my advice for Ph.D. applicants", "https://www.youtube.com/watch?v=JqD2arlzXVE", target: "_blank", rel: "noopener noreferrer"
          before you write your statement.
        %li
          = link_to "Follow me on Bluesky", "https://bsky.app/profile/sauvik.me", target: "_blank", rel: "noopener noreferrer"
          — I'll post there when my recruiting status changes for future cycles.
      %ul.recruiting-alternatives-list#intentCollabPanel{hidden: true}
        %li
          = mail_to "sauvik@cmu.edu", "Email me about collaborations or research questions", subject: "Collaboration"
          — those are always welcome, and don't depend on the recruiting cycle.
        %li
          %a{href: "/about", "data-turbolinks" => "false", "data-section-link" => true} Skim the research directions
          above to find overlap before reaching out.
        %li
          Visiting or press?
          = mail_to "sauvik@cmu.edu", "Email me", subject: "Visit / press inquiry"
          with dates and context and I'll route it.
      %p.recruiting-next-cycle
        My status for the next (2027–28) cycle will be posted here once decided — check back, or watch the
        = link_to "HCII admissions page", "https://www.hcii.cmu.edu/academics/phd-hci", target: "_blank", rel: "noopener noreferrer"
        for cycle timing.
    .recruiting-ctas
      = link_to "Apply via HCII", "https://www.hcii.cmu.edu/academics/phd-hci", class: "btn-sd btn-sd-primary", target: "_blank", rel: "noopener noreferrer"
      = link_to "Watch advice for applicants", "https://www.youtube.com/watch?v=JqD2arlzXVE", class: "recruiting-advice-link", target: "_blank", rel: "noopener noreferrer"
  %p.recruiting-updated
    = "Last updated #{@recruiting_status_updated_at}"

%section#students
  = render "static_pages/section_label", section: "students", show_name: false
  %h2.section-title Students
  %p.section-subtitle The people who do the work in the SPUD Lab — current and former.
  = react_component('StudentsContainer', currentStudents: @currentStudents, alums: @alums)

-# The publications content lives inside the #publications anchor so section
-# tracking (journey_tracking.js) counts reading papers as time in the section.
%section#publications
  = render "static_pages/section_label", section: "publications", show_name: false
  %h2.section-title Publications
  %p.section-subtitle= "#{@papers_count} papers, #{@papers_year_range}."
  = react_component('TabContainer',
      papersUrl: papers_url(format: :json),
      paperAssets: @paperAssetMap,
      paperPollInterval: 10000,
      awardsUrl: awards_url(format: :json),
      courses: @courses,
      currentStudents: @currentStudents,
      alums: @alums)
-# SF-01/SF-11: full papers list works without JavaScript — plain links, plain pagination
%noscript
  .noscript-papers
    .about-text
      JavaScript is disabled — here is the same publications list as plain links.
    -# SF-11: plain GET search — the server filters this list via the same ?q= param
    %form.noscript-search{action: "/publications", method: "get"}
      %label{for: "noscript-q"} Search papers, authors, venues:
      %input#noscript-q{type: "search", name: "q", value: params[:q]}
      %button{type: "submit"} Search
    .noscript-filter-summary
      - if @noscript_filters.any?
        %span= "Filtered: #{@noscript_filters.join(' · ')} — #{@noscript_filtered_count} #{'paper'.pluralize(@noscript_filtered_count)}."
        = link_to "View all papers", "/publications", "data-turbolinks" => "false"
      - else
        %span= "All #{@noscript_filtered_count} papers, newest first."
    %ol.noscript-paper-list{start: (@noscript_page - 1) * @noscript_page_size + 1}
      - @noscript_papers.each do |paper|
        %li
          -# Same source order as the React card: hosted PDF → publisher page → Google Scholar,
          -# so every title is a working link even with JavaScript unavailable.
          - noscript_href = paper.pdf.present? ? "/papers/#{paper.id}/serve" : (paper.html_paper_url.presence || "https://scholar.google.com/scholar?q=#{CGI.escape(paper.title.to_s)}")
          = link_to paper.title, noscript_href, target: "_blank", rel: "noopener noreferrer"
          %span.noscript-paper-meta= " · #{paper.venue} · #{paper.year}"
          - if paper.doi.present?
            = link_to "DOI", "https://doi.org/#{paper.doi}", target: "_blank", rel: "noopener noreferrer"
    %nav.noscript-pagination{"aria-label" => "Publications pages (no JavaScript)"}
      %span= "Page #{@noscript_page} of #{@noscript_total_pages}."
      -# Page anchors carry the active ?tag/?sort/?q/?year filters through
      - noscript_page_href = ->(p) { "/publications?#{@noscript_link_params.merge(page: p).to_query}" }
      - if @noscript_page > 1
        = link_to "← Previous page", noscript_page_href.call(@noscript_page - 1), "data-turbolinks" => "false"
      - (1..@noscript_total_pages).each do |p|
        - if p == @noscript_page
          %strong= p
        - else
          = link_to p, noscript_page_href.call(p), "data-turbolinks" => "false"
      - if @noscript_page < @noscript_total_pages
        = link_to "Next page →", noscript_page_href.call(@noscript_page + 1), "data-turbolinks" => "false"

:javascript
  (function() {
    // Recognition card → award-filtered publications view (in-page when possible)
    var link = document.getElementById('awardsFilterLink');
    if (link) link.addEventListener('click', function(e) {
      e.preventDefault();
      document.getElementById('publications').scrollIntoView({ behavior: 'smooth' });
      setTimeout(function() {
        window.dispatchEvent(new CustomEvent('setActiveFilter', { detail: { filter: 'Award-winning' } }));
      }, 300);
    });

    // SF-11: "+ N more directions" reveals the collapsed themes
    var toggle = document.getElementById('directionsToggle');
    if (toggle) toggle.addEventListener('click', function() {
      var container = document.getElementById('researchDirections');
      var expanded = container.classList.toggle('is-expanded');
      toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      toggle.childNodes[0].textContent = expanded ? 'Show fewer directions' : '+ #{@research_directions.length - 3} more directions';
    });

    // SF-05: recruiting intent chooser — reveal the guidance that fits the visitor
    var intentStudent = document.getElementById('intentStudentBtn');
    var intentCollab = document.getElementById('intentCollabBtn');
    var studentPanel = document.getElementById('intentStudentPanel');
    var collabPanel = document.getElementById('intentCollabPanel');
    function pickIntent(studentActive) {
      if (!intentStudent || !intentCollab) return;
      intentStudent.classList.toggle('active', studentActive);
      intentCollab.classList.toggle('active', !studentActive);
      intentStudent.setAttribute('aria-pressed', String(studentActive));
      intentCollab.setAttribute('aria-pressed', String(!studentActive));
      studentPanel.hidden = !studentActive;
      collabPanel.hidden = studentActive;
    }
    if (intentStudent) intentStudent.addEventListener('click', function() { pickIntent(true); });
    if (intentCollab) intentCollab.addEventListener('click', function() { pickIntent(false); });

    // SF-11: per-theme "Show N more" link reveal
    document.querySelectorAll('.research-dir-more').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var dir = btn.closest('.research-dir');
        dir.querySelectorAll('.project-highlight.is-extra').forEach(function(a) { a.hidden = false; });
        btn.remove();
      });
    });
  })();

