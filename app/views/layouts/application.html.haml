              %a.social-btn{href: "https://hci.social/@sauvik", target: "_blank", rel: "noopener noreferrer", title: "Mastodon", "aria-label" => "Mastodon"}
                %svg{width: "16", height: "16", viewBox: "0 0 24 24", fill: "currentColor"}
                  %path{d: "M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"}
          .site-footer-col
            %span.site-footer-label Sections
            - %w[about recruiting students publications].each do |section|
              %a.site-footer-row{href: "/#{section}", "data-turbolinks" => "false", "data-section-link" => true}
                %span.site-footer-link= section.capitalize
                %span.site-footer-meta= "/#{section}"
          .site-footer-col
            %span.site-footer-label Publication views
            - (@publication_views || []).each do |view|
              %a.site-footer-row{href: view[:href], "data-turbolinks" => "false"}
                %span.site-footer-link= view[:label]
                %span.site-footer-meta= view[:meta]
          .site-footer-col
            %span.site-footer-label Links
            %a.site-footer-row{href: asset_path("cv.pdf"), data: { analytics_event: "cv_download" }}
              %span.site-footer-link CV (PDF)
              %span.site-footer-ext ↗
            %a.site-footer-row{href: "https://sauvik-das.medium.com/", target: "_blank", rel: "noopener noreferrer"}
              %span.site-footer-link Academic Blog
              %span.site-footer-ext ↗
            %a.site-footer-row{href: "https://www.fuguux.com", target: "_blank", rel: "noopener noreferrer"}
              %span.site-footer-link FuguUX
              %span.site-footer-ext ↗
            %a.site-footer-row{href: "https://cs.cmu.edu/~spudlab", target: "_blank", rel: "noopener noreferrer"}
              %span.site-footer-link SPUD Lab
              %span.site-footer-ext ↗
        .site-footer-bottom
          %span= "© #{DateTime.now.year} Sauvik Das · Human-Computer Interaction Institute, Carnegie Mellon University."
          %span.site-footer-updated= "Last updated #{@recruiting_status_updated_at || "April 2026"}"
    :javascript
      (function() {
        // Section ids are an analytics invariant (journey_tracking.js, AnalyticsEventsController::SECTIONS)
        var sections = ['about', 'recruiting', 'students', 'publications'];
        var navLinks = {};
        sections.forEach(function(id) {
          navLinks[id] = document.querySelectorAll('.sidebar-nav a[href="/' + id + '"]');
        });

        function isSectionPath(path) {
          return path === '/' || sections.indexOf(path.slice(1)) !== -1;
        }
        function pathSection(path) {
          return path === '/' ? 'about' : path.slice(1);
        }

        function scrollOffset() {
          var header = document.getElementById('mobileHeader');
          return 16 + (header ? header.offsetHeight : 0);
        }

        function currentSection() {
          // Threshold matches scrollToSection's landing offset (plus slack), so a
          // section navigated to always registers as the active section.
          var threshold = scrollOffset() + 40;
          var current = sections[0];
          sections.forEach(function(id) {
            var el = document.getElementById(id);
            if (el && el.getBoundingClientRect().top <= threshold) current = id;
          });
          return current;
        }

        function updateActive() {
          var current = currentSection();
          sections.forEach(function(id) {
            navLinks[id].forEach(function(link) {
              link.classList.toggle('active', id === current);
            });
          });
          // SF-02/SF-13: URL mirrors the section in view; keep any publication filter params
          if (isSectionPath(location.pathname) && pathSection(location.pathname) !== current) {
            history.replaceState(history.state, '', '/' + current + location.search + location.hash);
          }
        }

        function scrollToSection(id, instant) {
          var el = document.getElementById(id);
          if (!el) return;
          var top = el.getBoundingClientRect().top + (window.scrollY || window.pageYOffset) - scrollOffset();
          window.scrollTo(instant ? { top: Math.max(top, 0), behavior: 'instant' } : { top: Math.max(top, 0), behavior: 'smooth' });
        }

        // SF-02: same-page section links navigate without a Turbolinks round-trip
        document.querySelectorAll('a[data-section-link]').forEach(function(link) {
          link.addEventListener('click', function(e) {
            var id = link.getAttribute('href').replace(/^\//, '');
            if (document.getElementById(id)) {
              e.preventDefault();
              history.pushState({}, '', '/' + id + location.search);
              scrollToSection(id, false);
            }
          });
        });

        window.addEventListener('popstate', function() {
          // Pathname-driven only; TabContainer owns search-param popstate handling
          if (isSectionPath(location.pathname)) scrollToSection(pathSection(location.pathname), false);
        });

        // SF-02: /about-style entry URLs land on their section (React sections settle late,
        // so retry until offsets stabilize unless the visitor has taken over scrolling)
        var target = document.body.getAttribute('data-scroll-target');
        if (target && !location.hash) {
          var userScrolled = false;
          ['wheel', 'touchstart', 'keydown'].forEach(function(evt) {
            window.addEventListener(evt, function() { userScrolled = true; }, { passive: true, once: true });
          });
          scrollToSection(target, true);
          [250, 750].forEach(function(delay) {
            setTimeout(function() { if (!userScrolled) scrollToSection(target, true); }, delay);
          });
        }

        updateActive();
        window.addEventListener('scroll', updateActive, { passive: true });
      })();

      (function() {
        var toggle = document.getElementById('drawerToggle');
        var drawer = document.getElementById('mobileDrawer');
        var overlay = document.getElementById('drawerOverlay');
        var close = document.getElementById('drawerClose');

        function openDrawer() { if (drawer) drawer.classList.add('open'); }
        function closeDrawer() { if (drawer) drawer.classList.remove('open'); }

        if (toggle) toggle.addEventListener('click', openDrawer);
        if (overlay) overlay.addEventListener('click', closeDrawer);
        if (close) close.addEventListener('click', closeDrawer);
        if (drawer) drawer.querySelectorAll('a[href^="#"], a[data-section-link]').forEach(function(a) {
          a.addEventListener('click', closeDrawer);
        });

        // Mobile header search: land in the publications search box
        var searchBtn = document.getElementById('mobileSearchBtn');
        if (searchBtn) searchBtn.addEventListener('click', function() {
          var pubs = document.getElementById('publications');
          if (pubs) pubs.scrollIntoView({ behavior: 'smooth' });
          setTimeout(function() {
            var input = document.getElementById('pubs-search-input');
            if (input) input.focus({ preventScroll: true });
          }, 400);
        });
      })();
