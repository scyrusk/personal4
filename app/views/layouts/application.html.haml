!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    - site_title = "Sauvik Das · Human-Centered Security, Privacy & AI"
    - page_title = (defined?(@page_title) && @page_title.present?) ? @page_title : site_title
    %title= page_title
    - if defined?(@page_description) && @page_description.present?
      %meta{name: "description", content: @page_description}/
    - if defined?(@canonical_url) && @canonical_url.present?
      %link{rel: "canonical", href: @canonical_url}/
    -# Open Graph
    %meta{property: "og:title", content: page_title}/
    - if defined?(@page_description) && @page_description.present?
      %meta{property: "og:description", content: @page_description}/
    %meta{property: "og:type", content: "profile"}/
    - if defined?(@canonical_url) && @canonical_url.present?
      %meta{property: "og:url", content: @canonical_url}/
    - if defined?(@og_image_url) && @og_image_url.present?
      %meta{property: "og:image", content: @og_image_url}/
    -# Twitter card
    %meta{name: "twitter:card", content: "summary_large_image"}/
    %meta{name: "twitter:title", content: page_title}/
    - if defined?(@page_description) && @page_description.present?
      %meta{name: "twitter:description", content: @page_description}/
    - if defined?(@og_image_url) && @og_image_url.present?
      %meta{name: "twitter:image", content: @og_image_url}/
    %link{rel: "icon", href: "/favicon.svg", type: "image/svg+xml"}/
    %link{rel: "icon", href: "/favicon.ico", sizes: "32x32"}/
    %link{rel: "apple-touch-icon", href: "/apple-touch-icon.png"}/
    %meta{name: "theme-color", content: "#2a6b3c"}/
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}/
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "anonymous"}/
    %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"}/
    = stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track' => true
    = javascript_include_tag 'application', 'data-turbolinks-track' => true
    = javascript_include_tag 'https://cdnjs.cloudflare.com/ajax/libs/mobx/5.15.7/mobx.umd.min.js'

    = csrf_meta_tags
    %meta{:content => "width=device-width, initial-scale=1.0", :name => "viewport"}/
  %body{data: { scroll_target: (defined?(@scroll_target) ? @scroll_target : nil) }}
    .mobile-header#mobileHeader
      .mobile-header-row
        %span.mobile-name Sauvik Das
        .mobile-header-actions
          %button.mobile-header-btn#mobileSearchBtn{"aria-label" => "Search publications"}
            %svg{width: "18", height: "18", viewBox: "0 0 16 16", fill: "none", stroke: "currentColor", "stroke-width": "1.5", "stroke-linecap": "round"}
              %circle{cx: "6.5", cy: "6.5", r: "4"}
              %line{x1: "10", y1: "10", x2: "14", y2: "14"}
          %button.mobile-header-btn#drawerToggle{"aria-label" => "Open menu"}
            %svg{width: "20", height: "20", viewBox: "0 0 22 22", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round"}
              %line{x1: "3", y1: "6", x2: "19", y2: "6"}
              %line{x1: "3", y1: "11", x2: "19", y2: "11"}
              %line{x1: "3", y1: "16", x2: "19", y2: "16"}
    .page-wrap
      %aside.sidebar
        = render partial: "layouts/sidebar"
      %main.main
        = yield
    .mobile-drawer#mobileDrawer
      .mobile-drawer-overlay#drawerOverlay
      .mobile-drawer-panel
        %button.mobile-drawer-close#drawerClose ×
        = render partial: "layouts/sidebar"
    -# SF-14/SF-02/SF-13: full footer — identity, section sitemap, shareable views, links
    %footer.site-footer{role: "contentinfo"}
      .site-footer-inner
        .site-footer-grid
          .site-footer-id
            %p.site-footer-name Sauvik Das
            %p.site-footer-blurb
              Associate Professor, Human-Computer Interaction Institute, Carnegie Mellon University.
              Director of the SPUD Lab.
            .site-footer-social
              %a.social-btn{href: "https://bsky.app/profile/sauvik.me", target: "_blank", rel: "noopener noreferrer", title: "Bluesky", "aria-label" => "Bluesky"}
                %svg{width: "16", height: "16", viewBox: "0 0 600 530", fill: "currentColor", xmlns: "http://www.w3.org/2000/svg"}
