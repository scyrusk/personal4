.analytics-header
  .analytics-header-title
    %h1 Analytics
    .analytics-live{title: "Distinct visitors with activity in the last 30 minutes"}
      %span.live-dot{"aria-hidden" => "true"}
      %span#liveCount= analytics_number(@current_visitors)
      active now
  .analytics-header-links
    = link_to "Export CSV", admin_analytics_export_path(period: @period)
    = link_to "Admin", admin_path
    = link_to "View site", root_path
%p.analytics-subtitle
  Self-hosted, cookieless analytics. Visitors are unique per day (the visitor token rotates daily),
  so multi-day totals are sums of daily uniques.

.period-row
  - AnalyticsController::PERIODS.each do |key, cfg|
    = link_to cfg[:label], admin_analytics_path(period: key), class: ("active" if key == @period)

.stat-row
  .card.stat-tile
    .stat-label Visitors
    .stat-value= analytics_number(@total_visitors)
    = analytics_delta_tag(@total_visitors, @prev_visitors)
  .card.stat-tile
    .stat-label Pageviews
    .stat-value= analytics_number(@total_pageviews)
    = analytics_delta_tag(@total_pageviews, @prev_pageviews)
  .card.stat-tile
    .stat-label Views per visitor
    .stat-value= @total_visitors.zero? ? "—" : (@total_pageviews.to_f / @total_visitors).round(1)
    %span.stat-delta.stat-delta-none this period
  .card.stat-tile
    .stat-label Downloads
    .stat-value= analytics_number(@downloads)
    = analytics_delta_tag(@downloads, @prev_downloads)

.card.chart-card
  %h2.card-title Visitors & pageviews per #{@granularity}
  - if @chart_pageviews.values.sum.zero? && @chart_visitors.values.sum.zero?
    .chart-empty No traffic recorded in this period yet.
  - else
    .chart-legend
      %span.legend-visitors
        %span.legend-key
        Visitors
      %span.legend-pageviews
        %span.legend-key
        Pageviews
    #visitorsChart.chart-container{tabindex: "0", role: "img",
      "aria-label" => "Line chart of #{@granularity == 'hour' ? 'hourly' : 'daily'} visitors and pageviews. Data available in the table below."}
      #chartTooltip.chart-tooltip
    %details.chart-table
      %summary View data table
      %table
        %thead
          %tr
            %th= @granularity == 'hour' ? 'Hour' : 'Date'
            %th Visitors
            %th Pageviews
        %tbody
          - @chart_visitors.each do |bucket, visitors|
            %tr
              %td= analytics_chart_label(bucket, long: true)
              %td= visitors
              %td= @chart_pageviews[bucket]

.card.chart-card
  %h2.card-title Visitor flow
  - if @journey[:total_sessions].zero?
    .chart-empty No visitor journeys recorded in this period yet.
  - else
    %p.flow-note
      How #{analytics_number(@journey[:total_sessions])} visits moved through the site, step by step.
      Ribbon width is the number of sessions taking that path.
    .chart-legend
      %span.legend-continued
        %span.legend-swatch
        Continued
      %span.legend-exited
        %span.legend-swatch
        Exited
    #journeyChart.chart-container.sankey-container{tabindex: "0", role: "img",
      "aria-label" => "Sankey diagram of aggregated visitor journeys through the site. Data available in the table below."}
      #journeyTooltip.chart-tooltip
    %details.chart-table.flow-table
      %summary View data table
      %table
        %thead
          %tr
            %th Step
            %th From
            %th To
            %th Sessions
        %tbody
          - @journey[:links].each do |link|
            - from = @journey[:nodes][link[:source]]
            - to = @journey[:nodes][link[:target]]
            %tr
              %td= from[:col] + 1
              %td= from[:label]
              %td= to[:label]
              %td= link[:count]

.panel-grid
  = render "breakdown", title: "Top sources", rows: @top_sources, unit: "visitors",
    empty: "No external traffic yet."
  = render "breakdown", title: "Top pages", rows: @top_pages, unit: "views",
    empty: "No pageviews yet.", linkify: true
  = render "breakdown", title: "Top downloads", rows: @top_downloads, unit: "downloads",
    empty: "No downloads yet."
  = render "breakdown", title: "Top referrers", rows: @top_referrers, unit: "visitors",
    empty: "No referrers yet."
  = render "breakdown", title: "Campaigns", rows: @top_campaigns, unit: "visitors",
    empty: "No campaign-tagged (utm_campaign) traffic yet."
  = render "breakdown", title: "Devices", rows: @devices, unit: "visitors",
    empty: "No device data yet."
  = render "breakdown", title: "Browsers", rows: @browsers, unit: "visitors",
    empty: "No browser data yet."
  = render "breakdown", title: "Operating systems", rows: @oses, unit: "visitors",
    empty: "No OS data yet."

%script#analyticsData{type: "application/json"}
  = raw({ labels: @chart_visitors.keys.map { |k| analytics_chart_label(k) },
          labelsLong: @chart_visitors.keys.map { |k| analytics_chart_label(k, long: true) },
          visitors: @chart_visitors.values,
          pageviews: @chart_visitors.keys.map { |k| @chart_pageviews[k] || 0 } }.to_json)

%script#journeyData{type: "application/json"}
  = raw @journey.to_json

:javascript
  // Keep the "active now" badge live (GA-style realtime, 60s poll).
  (function() {
    var count = document.getElementById('liveCount');
    if (!count || !window.fetch) return;
    setInterval(function() {
      fetch('#{admin_analytics_realtime_path}', { headers: { 'Accept': 'application/json' } })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(d) { if (d) count.textContent = d.current_visitors.toLocaleString(); })
        .catch(function() {});
    }, 60000);
  })();

  (function() {
    var container = document.getElementById('visitorsChart');
    if (!container) return;

    var data = JSON.parse(document.getElementById('analyticsData').textContent);
    var tooltip = document.getElementById('chartTooltip');
    var SVG_NS = 'http://www.w3.org/2000/svg';
    var SERIES = [
      { key: 'visitors',  name: 'Visitors',  color: '#2a6b3c' },
      { key: 'pageviews', name: 'Pageviews', color: '#2a78d6' }
    ];
    var PAD = { top: 12, right: 16, bottom: 26, left: 46 };
    var n = data.labels.length;
    var hoverIdx = -1;
    var svg = null, geom = null;

    // Smallest "nice" ceiling (1/2/5 × 10^k) at or above the data max.
    function niceMax(max) {
      if (max <= 0) return 1;
      var pow = Math.pow(10, Math.floor(Math.log(max) / Math.LN10));
      var candidates = [pow, 2 * pow, 5 * pow, 10 * pow];
      for (var i = 0; i < candidates.length; i++) {
        if (candidates[i] >= max) return candidates[i];
      }
      return 10 * pow;
    }

    function el(name, attrs) {
      var node = document.createElementNS(SVG_NS, name);
      for (var k in attrs) node.setAttribute(k, attrs[k]);
      return node;
    }

    function render() {
      var w = container.clientWidth;
      var h = container.clientHeight;
      if (svg) svg.remove();
      svg = el('svg', { width: w, height: h, viewBox: '0 0 ' + w + ' ' + h });

      var plotW = w - PAD.left - PAD.right;
      var plotH = h - PAD.top - PAD.bottom;
      var dataMax = Math.max.apply(null, data.visitors.concat(data.pageviews).concat([1]));
      // Integer "nice" tick step so every gridline label is a clean number.
      var yStep = Math.max(1, niceMax(dataMax / 4));
      var yMax = yStep * 4;
      var xAt = function(i) {
        return n === 1 ? PAD.left + plotW / 2 : PAD.left + (i * plotW) / (n - 1);
      };
      var yAt = function(v) { return PAD.top + plotH * (1 - v / yMax); };
      geom = { xAt: xAt, yAt: yAt, w: w, h: h };

      // Gridlines + y tick labels (4 divisions, clean numbers).
      var ticks = 4;
      for (var t = 0; t <= ticks; t++) {
        var val = yStep * t;
        var y = yAt(val);
        svg.appendChild(el('line', {
          x1: PAD.left, x2: w - PAD.right, y1: y, y2: y,
          stroke: t === 0 ? '#c3c2b7' : '#eeeee8', 'stroke-width': 1
        }));
        var label = el('text', {
          x: PAD.left - 8, y: y + 4, 'text-anchor': 'end',
          fill: '#7a7a72', 'font-size': 11
        });
        label.textContent = val >= 1000 ? (val / 1000) + 'K' : Math.round(val).toLocaleString();
        svg.appendChild(label);
      }

      // Sparse x labels (~6).
      var step = Math.max(1, Math.ceil(n / 6));
      for (var i = 0; i < n; i += step) {
        var xl = el('text', {
          x: xAt(i), y: h - 6, 'text-anchor': 'middle',
          fill: '#7a7a72', 'font-size': 11
        });
        xl.textContent = data.labels[i];
        svg.appendChild(xl);
      }

      // Series lines with an end marker (2px surface ring).
      SERIES.forEach(function(s) {
        var vals = data[s.key];
        if (n > 1) {
          var pts = vals.map(function(v, i) { return xAt(i) + ',' + yAt(v); }).join(' ');
          svg.appendChild(el('polyline', {
            points: pts, fill: 'none', stroke: s.color,
            'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round'
          }));
        }
        svg.appendChild(el('circle', {
          cx: xAt(n - 1), cy: yAt(vals[n - 1]), r: 4,
          fill: s.color, stroke: '#ffffff', 'stroke-width': 2
        }));
      });

      // Crosshair + hover dots, hidden until hover/focus.
      var hoverLayer = el('g', { 'data-hover': '1', visibility: 'hidden' });
      hoverLayer.appendChild(el('line', {
        x1: 0, x2: 0, y1: PAD.top, y2: h - PAD.bottom,
        stroke: '#c3c2b7', 'stroke-width': 1
      }));
      SERIES.forEach(function(s) {
        hoverLayer.appendChild(el('circle', {
          r: 4, fill: s.color, stroke: '#ffffff', 'stroke-width': 2
        }));
      });
      svg.appendChild(hoverLayer);
      container.insertBefore(svg, tooltip);
      if (hoverIdx >= 0) showHover(hoverIdx);
    }

    function showHover(idx) {
      hoverIdx = Math.max(0, Math.min(n - 1, idx));
      var x = geom.xAt(hoverIdx);
      var layer = svg.querySelector('[data-hover]');
      layer.setAttribute('visibility', 'visible');
      var line = layer.querySelector('line');
      line.setAttribute('x1', x);
      line.setAttribute('x2', x);
      var dots = layer.querySelectorAll('circle');
      SERIES.forEach(function(s, si) {
        dots[si].setAttribute('cx', x);
        dots[si].setAttribute('cy', geom.yAt(data[s.key][hoverIdx]));
      });

      // Tooltip: values lead, series names follow, keyed by a line swatch.
      tooltip.textContent = '';
      var dateEl = document.createElement('div');
      dateEl.className = 'tt-date';
      dateEl.textContent = data.labelsLong[hoverIdx];
      tooltip.appendChild(dateEl);
      SERIES.forEach(function(s) {
        var row = document.createElement('div');
        row.className = 'tt-row';
        var key = document.createElement('span');
        key.className = 'tt-key';
        key.style.borderTopColor = s.color;
        var value = document.createElement('span');
        value.className = 'tt-value';
        value.textContent = data[s.key][hoverIdx].toLocaleString();
        var name = document.createElement('span');
        name.className = 'tt-name';
        name.textContent = s.name;
        row.appendChild(key);
        row.appendChild(value);
        row.appendChild(name);
        tooltip.appendChild(row);
      });
      tooltip.style.display = 'block';
      var ttW = tooltip.offsetWidth;
      var left = x + 12 + ttW > geom.w ? x - ttW - 12 : x + 12;
      tooltip.style.left = left + 'px';
      tooltip.style.top = PAD.top + 'px';
    }

    function hideHover() {
      hoverIdx = -1;
      tooltip.style.display = 'none';
      var layer = svg && svg.querySelector('[data-hover]');
      if (layer) layer.setAttribute('visibility', 'hidden');
    }

    function idxFromEvent(e) {
      var rect = container.getBoundingClientRect();
      var x = e.clientX - rect.left;
      if (n === 1) return 0;
      var plotW = geom.w - PAD.left - PAD.right;
      return Math.round(((x - PAD.left) / plotW) * (n - 1));
    }

    container.addEventListener('pointermove', function(e) { showHover(idxFromEvent(e)); });
    container.addEventListener('pointerleave', hideHover);
    container.addEventListener('focus', function() { showHover(n - 1); });
    container.addEventListener('blur', hideHover);
    container.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') { showHover(hoverIdx < 0 ? n - 1 : hoverIdx - 1); e.preventDefault(); }
      if (e.key === 'ArrowRight') { showHover(hoverIdx < 0 ? 0 : hoverIdx + 1); e.preventDefault(); }
      if (e.key === 'Escape') hideHover();
    });

    var resizeQueued = false;
    window.addEventListener('resize', function() {
      if (resizeQueued) return;
      resizeQueued = true;
      requestAnimationFrame(function() { resizeQueued = false; render(); });
    });

    render();
  })();

  // Visitor-flow sankey: columns are journey steps, ribbons are session counts.
  (function() {
    var container = document.getElementById('journeyChart');
    if (!container) return;

    var data = JSON.parse(document.getElementById('journeyData').textContent);
    var tooltip = document.getElementById('journeyTooltip');
    var SVG_NS = 'http://www.w3.org/2000/svg';
    var NODE_W = 10;
    var GAP = 8;
    var PAD = { top: 10, right: 12, bottom: 10, left: 12 };
    var NODE_COLORS = { page: '#2a6b3c', other: '#7a7a72', more: '#7a7a72', exit: '#b9b8ae' };
    var LINK_COLORS = {
      go:   { rest: 'rgba(42, 107, 60, 0.22)',  hover: 'rgba(42, 107, 60, 0.42)' },
      exit: { rest: 'rgba(122, 122, 114, 0.18)', hover: 'rgba(122, 122, 114, 0.38)' }
    };
    var svg = null;

    function el(name, attrs) {
      var node = document.createElementNS(SVG_NS, name);
      for (var k in attrs) node.setAttribute(k, attrs[k]);
      return node;
    }

    function truncate(text, maxChars) {
      return text.length > maxChars ? text.slice(0, Math.max(1, maxChars - 1)) + '…' : text;
    }

    // Node heights and ribbon offsets for the current container size.
    function layout(w, h) {
      var cols = 0;
      data.nodes.forEach(function(n) { cols = Math.max(cols, n.col + 1); });
      var plotW = w - PAD.left - PAD.right - NODE_W;
      var plotH = h - PAD.top - PAD.bottom;

      var byCol = [];
      for (var c = 0; c < cols; c++) byCol.push([]);
      data.nodes.forEach(function(n) { byCol[n.col].push(n); });
      // Busiest pages first; the fold/continuation/exit buckets sink to the bottom.
      var rank = { page: 0, other: 1, more: 2, exit: 3 };
      byCol.forEach(function(col) {
        col.sort(function(a, b) { return rank[a.kind] - rank[b.kind] || b.count - a.count; });
      });

      // One px-per-session scale everywhere: the busiest column must fit.
      var scale = Infinity;
      byCol.forEach(function(col) {
        var total = col.reduce(function(sum, n) { return sum + n.count; }, 0);
        scale = Math.min(scale, (plotH - (col.length - 1) * GAP) / total);
      });

      byCol.forEach(function(col, c) {
        var height = (col.length - 1) * GAP +
          col.reduce(function(sum, n) { return sum + n.count * scale; }, 0);
        var y = PAD.top + (plotH - height) / 2;
        col.forEach(function(n) {
          n.x = PAD.left + (cols === 1 ? 0 : c * plotW / (cols - 1));
          n.y = y;
          n.h = Math.max(2, n.count * scale);
          n.outY = y;
          n.inY = y;
          y += n.count * scale + GAP;
        });
      });

      var links = data.links.map(function(l) {
        return { source: data.nodes[l.source], target: data.nodes[l.target], count: l.count };
      });
      // Stack each node's ribbons by the far end's height so they don't cross.
      links.slice().sort(function(a, b) { return a.target.y - b.target.y; })
        .forEach(function(l) { l.sy = l.source.outY; l.source.outY += l.count * scale; });
      links.slice().sort(function(a, b) { return a.source.y - b.source.y; })
        .forEach(function(l) { l.ty = l.target.inY; l.target.inY += l.count * scale; });

      return { cols: cols, plotW: plotW, scale: scale, links: links };
    }

    function ribbonPath(l, scale) {
      var x0 = l.source.x + NODE_W;
      var x1 = l.target.x;
      var t = Math.max(1.5, l.count * scale);
      var mx = (x0 + x1) / 2;
      return 'M' + x0 + ',' + l.sy +
             'C' + mx + ',' + l.sy + ' ' + mx + ',' + l.ty + ' ' + x1 + ',' + l.ty +
             'L' + x1 + ',' + (l.ty + t) +
             'C' + mx + ',' + (l.ty + t) + ' ' + mx + ',' + (l.sy + t) + ' ' +
                   x0 + ',' + (l.sy + t) + 'Z';
    }

    function showTooltip(e, title, rows) {
      tooltip.textContent = '';
      var titleEl = document.createElement('div');
      titleEl.className = 'tt-date';
      titleEl.textContent = title;
      tooltip.appendChild(titleEl);
      rows.forEach(function(r) {
        var row = document.createElement('div');
        row.className = 'tt-row';
        var value = document.createElement('span');
        value.className = 'tt-value';
        value.textContent = r[0];
        var name = document.createElement('span');
        name.className = 'tt-name';
        name.textContent = r[1];
        row.appendChild(value);
        row.appendChild(name);
        tooltip.appendChild(row);
      });
      tooltip.style.display = 'block';
      moveTooltip(e);
    }

    function moveTooltip(e) {
      var rect = container.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      var left = x + 14 + tooltip.offsetWidth > rect.width ? x - tooltip.offsetWidth - 14 : x + 14;
      var top = Math.min(y + 14, rect.height - tooltip.offsetHeight - 4);
      tooltip.style.left = Math.max(0, left) + 'px';
      tooltip.style.top = Math.max(0, top) + 'px';
    }

    function hideTooltip() { tooltip.style.display = 'none'; }

    function pct(part, whole) {
      return whole > 0 ? Math.round((part * 100.0) / whole) + '%' : '—';
    }

    function hoverable(shape, enter) {
      shape.addEventListener('pointerenter', enter);
      shape.addEventListener('pointermove', moveTooltip);
      shape.addEventListener('pointerleave', hideTooltip);
    }

    function render() {
      var w = container.clientWidth;
      var h = container.clientHeight;
      if (svg) svg.remove();
      svg = el('svg', { width: w, height: h, viewBox: '0 0 ' + w + ' ' + h });

      var geom = layout(w, h);
      var colSpace = geom.cols === 1 ? geom.plotW : geom.plotW / (geom.cols - 1);
      // The last column's labels sit left of their nodes, in the same corridor
      // as the previous column's labels — reserve room so they never collide.
      var maxChars = function(col) {
        var space = colSpace - NODE_W - 14 - (col === geom.cols - 2 ? 76 : 0);
        return Math.max(5, Math.floor(space / 6.2));
      };

      geom.links.forEach(function(l) {
        var colors = LINK_COLORS[l.target.kind === 'exit' ? 'exit' : 'go'];
        var path = el('path', { d: ribbonPath(l, geom.scale), fill: colors.rest });
        hoverable(path, function(e) {
          path.setAttribute('fill', colors.hover);
          showTooltip(e, l.source.label + ' → ' + l.target.label, [
            [l.count.toLocaleString(), 'sessions'],
            [pct(l.count, l.source.count), 'of “' + truncate(l.source.label, 26) + '”']
          ]);
        });
        path.addEventListener('pointerleave', function() { path.setAttribute('fill', colors.rest); });
        svg.appendChild(path);
      });

      data.nodes.forEach(function(n) {
        svg.appendChild(el('rect', {
          x: n.x, y: n.y, width: NODE_W, height: n.h, rx: 2, fill: NODE_COLORS[n.kind]
        }));

        // Side labels in text tokens; tight columns fall back to the tooltip/table.
        var lastCol = n.col === geom.cols - 1;
        if (n.h + GAP >= 14) {
          var label = el('text', {
            x: lastCol ? n.x - 6 : n.x + NODE_W + 6,
            y: n.y + n.h / 2 + 4,
            'text-anchor': lastCol ? 'end' : 'start',
            fill: '#4a4a45', 'font-size': 11.5
          });
          label.textContent = truncate(n.label, maxChars(n.col));
          var countSpan = document.createElementNS(SVG_NS, 'tspan');
          countSpan.setAttribute('fill', '#7a7a72');
          countSpan.textContent = ' ' + n.count.toLocaleString();
          label.appendChild(countSpan);
          svg.appendChild(label);
        }

        // Oversized invisible hit target: a 10px node is too thin to hover.
        var hit = el('rect', {
          x: n.x - 7, y: n.y - 4, width: NODE_W + 14, height: n.h + 8,
          fill: 'transparent'
        });
        hoverable(hit, function(e) {
          showTooltip(e, n.label + (n.col > 0 ? ' — step ' + (n.col + 1) : ''), [
            [n.count.toLocaleString(), 'sessions'],
            [pct(n.count, data.total_sessions), 'of all visits']
          ]);
        });
        svg.appendChild(hit);
      });

      container.insertBefore(svg, tooltip);
    }

    var resizeQueued = false;
    window.addEventListener('resize', function() {
      if (resizeQueued) return;
      resizeQueued = true;
      requestAnimationFrame(function() { resizeQueued = false; render(); });
    });

    render();
  })();
